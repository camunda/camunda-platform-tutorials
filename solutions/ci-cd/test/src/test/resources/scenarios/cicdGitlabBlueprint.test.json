        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "createRepositoryFile"
          },
          "variables": {}
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "openMergeRequest"
          },
          "variables": {
            "createdMergeRequest": {
              "id": "mr-001"
            }
          }
        },
        {
          "type": "PUBLISH_MESSAGE",
          "name": "977b3fd3-9a57-4fb3-8a93-c81f48f99622",
          "correlationKey": "mr-001",
          "variables": {
            "mergeRequestWebhookPayload": {
              "object_attributes": {
                "action": "merge",
                "id": "mr-001"
              }
            }
          }
        },
        {
          "type": "PUBLISH_MESSAGE",
          "name": "cbe375f3-ee90-483e-a3e0-803641904bb0",
          "correlationKey": "dev",
          "variables": {
            "devDeploymentWebhookPayload": {
              "deployedFolder": "my-folder",
