          "variables": {
            "folder": {
              "metadata": {
                "name": "my-folder"
              },
              "content": {
                "files": [
                  {
                    "id": "file-123",
                    "name": "my-process.bpmn",
                    "type": "BPMN"
                  }
                ]
              }
            }
          }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "createMilestone"
          },
          "variables": {
            "milestoneId": "milestone-001"
