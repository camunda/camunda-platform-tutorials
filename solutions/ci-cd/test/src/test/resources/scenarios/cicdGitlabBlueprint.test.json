{
  "$schema": "https://camunda.com/json-schema/cpt-test-cases/8.9/schema.json",
  "testCases": [
    {
      "name": "happy path - BPMN file updated and deployed to all environments",
      "description": "CI/CD pipeline triggered. BPMN file found in folder. Milestone created. File content retrieved. No prior milestone (getLatestMilestone returns null). Branch created, file updated in repo, MR merged, deployed successfully to dev, stage, and prod.",
      "instructions": [
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": {
            "processDefinitionId": "cicdGitlabBlueprint"
          },
          "variables": {
            "folder": {
              "metadata": {
                "name": "my-folder"
              }
            },
            "webModelerFolderId": "folder-123"
          }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "getWebModelerToken"
          },
          "variables": {
            "webModelerToken": "token-abc"
          }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "getFolderDetails"
          },
          "variables": {
            "folder": {
              "metadata": {
                "name": "my-folder"
              },
              "content": {
                "files": [
                  {
                    "id": "file-123",
                    "name": "my-process.bpmn",
                    "type": "BPMN"
                  }
                ]
              }
            }
          }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "createMilestone"
          },
          "variables": {
            "milestoneId": "milestone-001"
          }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "getFileContent"
          },
          "variables": {
            "content": "<bpmn:process/>"
          }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "getLatestMilestone"
          },
          "variables": {}
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "createBranch"
          },
          "variables": {}
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "checkFileExists"
          },
          "variables": {
            "fileExists": true
          }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "updateRepositoryFile"
          },
          "variables": {}
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "openMergeRequest"
          },
          "variables": {
            "createdMergeRequest": {
              "id": "mr-001"
            }
          }
        },
        {
          "type": "PUBLISH_MESSAGE",
          "name": "977b3fd3-9a57-4fb3-8a93-c81f48f99622",
          "correlationKey": "mr-001",
          "variables": {
            "mergeRequestWebhookPayload": {
              "object_attributes": {
                "action": "update",
                "id": "mr-001"
              }
            }
          }
        },
        {
          "type": "PUBLISH_MESSAGE",
          "name": "977b3fd3-9a57-4fb3-8a93-c81f48f99622",
          "correlationKey": "mr-001",
          "variables": {
            "mergeRequestWebhookPayload": {
              "object_attributes": {
                "action": "merge",
                "id": "mr-001"
              }
            }
          }
        },
        {
          "type": "PUBLISH_MESSAGE",
          "name": "cbe375f3-ee90-483e-a3e0-803641904bb0",
          "correlationKey": "dev",
          "variables": {
            "devDeploymentWebhookPayload": {
              "deployedFolder": "my-folder",
              "status": "success"
            }
          }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "createMilestoneForDevDeployment"
          },
          "variables": {}
        },
        {
          "type": "COMPLETE_USER_TASK",
          "userTaskSelector": {
            "elementId": "manualQaTest"
          },
          "variables": {}
        },
        {
          "type": "PUBLISH_MESSAGE",
          "name": "9a53a5e9-436b-43d7-b0fe-2e8f1575b5cd",
          "correlationKey": "stage",
          "variables": {
            "stageDeploymentWebhookPayload": {
              "deployedFolder": "my-folder",
              "status": "success"
            }
          }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "createMilestoneForStageDeployment"
          },
          "variables": {}
        },
        {
          "type": "PUBLISH_MESSAGE",
          "name": "66da4b0d-b541-4de4-9ad0-436f2fd7f2c5",
          "correlationKey": "prod",
          "variables": {
            "prodDeploymentWebhookPayload": {
              "deployedFolder": "my-folder",
              "status": "success"
            }
          }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "createMilestoneForProdDeployment"
          },
          "variables": {}
        },
        {
          "type": "ASSERT_PROCESS_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "cicdGitlabBlueprint"
          },
          "state": "IS_COMPLETED"
        }
      ]
    },
    {
      "name": "file does not exist in repo - new file created via error boundary",
      "description": "CI/CD pipeline triggered. During merge request generation the file is not yet present in the repository, so checkFileExists throws a 'file not found' error. The error boundary routes to creating a new repository file, then the pipeline merges and deploys successfully to all environments.",
