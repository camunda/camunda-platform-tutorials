        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "getFileContent"
          },
          "variables": {
            "content": "<bpmn:process/>"
          }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "getLatestMilestone"
          },
          "variables": {}
        },
        {
          "type": "COMPLETE_JOB",
