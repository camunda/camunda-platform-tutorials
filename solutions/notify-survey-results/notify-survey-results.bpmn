<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="1.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="notify-survey-results" name="Notify Survey Results" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Report submitted">
      <bpmn:outgoing>Flow_ToSlack</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="SendSlack" name="Send to Slack" zeebe:modelerTemplate="io.camunda.connectors.Slack.v1" zeebe:modelerTemplateVersion="9" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:slack:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="{{secrets.SLACK_TOKEN}}" target="token" />
          <zeebe:input source="chat.postMessage" target="method" />
          <zeebe:input source="messageBlock" target="data.messageType" />
          <zeebe:input source="=[{type: &quot;header&quot;, text: {type: &quot;plain_text&quot;, text: &quot;Agent Config Discoverability - New Feedback&quot;, emoji: true}}, {type: &quot;section&quot;, fields: [{type: &quot;mrkdwn&quot;, text: &quot;*From:* &quot; + if name != null and name != &quot;&quot; then name else &quot;_anonymous_&quot;}, {type: &quot;mrkdwn&quot;, text: &quot;*Submitted:* &quot; + string(today())}]}, {type: &quot;section&quot;, text: {type: &quot;mrkdwn&quot;, text: &quot;*Overall reaction*\n&quot; + if message != null and message != &quot;&quot; then message else &quot;_no response_&quot;}}, {type: &quot;divider&quot;}, {type: &quot;section&quot;, text: {type: &quot;mrkdwn&quot;, text: &quot;*Prototype observations*\n&quot; + if protoObservations != null and protoObservations != &quot;&quot; then protoObservations else &quot;_no observations_&quot;}}, {type: &quot;divider&quot;}, {type: &quot;header&quot;, text: {type: &quot;plain_text&quot;, text: &quot;Open Questions&quot;, emoji: true}}, {type: &quot;section&quot;, text: {type: &quot;mrkdwn&quot;, text: &quot;:small_blue_diamond: *Q1 - Modeling UX Specialization*\n*&quot; + (if q1Label != null then q1Label else &quot;_unanswered_&quot;) + &quot;*&quot; + (if q1Comment != null and q1Comment != &quot;&quot; then &quot;\n&quot; + q1Comment else &quot;&quot;)}}, {type: &quot;section&quot;, text: {type: &quot;mrkdwn&quot;, text: &quot;:small_blue_diamond: *Q2 - How much should the modeler fix problems*\n*&quot; + (if q2Label != null then q2Label else &quot;_unanswered_&quot;) + &quot;*&quot; + (if q2Comment != null and q2Comment != &quot;&quot; then &quot;\n&quot; + q2Comment else &quot;&quot;)}}, {type: &quot;section&quot;, text: {type: &quot;mrkdwn&quot;, text: &quot;:small_blue_diamond: *Q3 - Expose the system, or hide it*\n*&quot; + (if q3Label != null then q3Label else &quot;_unanswered_&quot;) + &quot;*&quot; + (if q3Comment != null and q3Comment != &quot;&quot; then &quot;\n&quot; + q3Comment else &quot;&quot;)}}, {type: &quot;section&quot;, text: {type: &quot;mrkdwn&quot;, text: &quot;:small_blue_diamond: *Q4 - Cold-start only, or also repair*\n*&quot; + (if q4Label != null then q4Label else &quot;_unanswered_&quot;) + &quot;*&quot; + (if q4Comment != null and q4Comment != &quot;&quot; then &quot;\n&quot; + q4Comment else &quot;&quot;)}}, {type: &quot;section&quot;, text: {type: &quot;mrkdwn&quot;, text: &quot;:small_blue_diamond: *Q5 - React to mistakes, or prevent them*\n*&quot; + (if q5Label != null then q5Label else &quot;_unanswered_&quot;) + &quot;*&quot; + (if q5Comment != null and q5Comment != &quot;&quot; then &quot;\n&quot; + q5Comment else &quot;&quot;)}}, {type: &quot;section&quot;, text: {type: &quot;mrkdwn&quot;, text: &quot;:small_blue_diamond: *Q6 - Scope of linting and Fix*\n*&quot; + (if q6Label != null then q6Label else &quot;_unanswered_&quot;) + &quot;*&quot; + (if q6Comment != null and q6Comment != &quot;&quot; then &quot;\n&quot; + q6Comment else &quot;&quot;)}}]" target="data.blockContent" />
          <zeebe:input source="C0BBAB1CGUB" target="data.channel" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="9" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.Slack.v1" />
          <zeebe:header key="resultExpression" value="={&#10;  myResponse: response&#10;  // Use FEEL to extract values depending on message&#10;  // type, e.g.,: myMessage: response.message.text&#10;}" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSlack</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_1" name="Notification sent">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToSlack" sourceRef="StartEvent_1" targetRef="SendSlack" />
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="SendSlack" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="notify-survey-results">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="252" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="130" y="295" width="81" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendSlack_di" bpmnElement="SendSlack">
        <dc:Bounds x="260" y="230" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="432" y="252" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="406" y="295" width="88" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToSlack_di" bpmnElement="Flow_ToSlack">
        <di:waypoint x="188" y="270" />
        <di:waypoint x="260" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToEnd_di" bpmnElement="Flow_ToEnd">
        <di:waypoint x="360" y="270" />
        <di:waypoint x="432" y="270" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
